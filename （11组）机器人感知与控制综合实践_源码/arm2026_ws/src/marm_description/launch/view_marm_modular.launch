<launch>
    <param name="robot_description" command="$(find xacro)/xacro $(find marm_description)/urdf/marm_modular.xacro" />
    <param name="use_gui" value="true"/>
    <node name="marm_modular_joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />
    <node name="marm_modular_robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <node name="marm_modular_rviz" pkg="rviz" type="rviz" args="-d $(find marm_description)/urdf_modular.rviz" required="true" />
</launch>
