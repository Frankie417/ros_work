Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 16
      Alpha: 0.25
    - Class: rviz/RobotModel
      Name: Arm
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/MarkerArray
      Name: Colour cubes and sorting stations
      Enabled: true
      Marker Topic: /color_pick/markers
      Queue Size: 10
    - Class: rviz/Image
      Name: HSV detections - virtual camera
      Enabled: true
      Image Topic: /color_pick/detection_image
      Transport Hint: raw
      Queue Size: 2
  Global Options:
    Background Color: 32; 42; 55
    Fixed Frame: marm_mod_base_link
    Frame Rate: 30
  Enabled: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.05
      Focal Point: {X: 0.16, Y: 0, Z: 0.20}
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1400
  Height: 900
