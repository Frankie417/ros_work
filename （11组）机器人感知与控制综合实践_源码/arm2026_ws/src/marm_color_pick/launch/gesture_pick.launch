<launch>
  <arg name="rviz" default="true"/>
  <include file="$(find marm_color_pick)/launch/color_pick.launch">
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="auto_start" value="false"/>
  </include>
  <node name="arm_gesture_bridge" pkg="marm_color_pick" type="gesture_bridge.py" output="screen"/>
</launch>
