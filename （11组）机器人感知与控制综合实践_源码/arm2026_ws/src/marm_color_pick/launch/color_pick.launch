<launch>
  <arg name="rviz" default="true"/>
  <arg name="auto_start" default="true"/>
  <arg name="external_perception" default="false"/>
  <arg name="rviz_config" default="$(find marm_color_pick)/config/color_pick.rviz"/>
  <param name="robot_description" command="$(find xacro)/xacro '$(find marm_description)/urdf/marm_modular.xacro'"/>
  <!-- No joint GUI: this demonstration is the sole /joint_states publisher. -->
  <node name="color_pick_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
  <node name="color_pick" pkg="marm_color_pick" type="color_pick_node.py" output="screen" required="true">
    <rosparam command="load" file="$(find marm_color_pick)/config/scene.yaml"/>
    <param name="auto_start" value="$(arg auto_start)"/>
    <param name="external_perception" value="$(arg external_perception)"/>
  </node>
  <node if="$(arg rviz)" name="color_pick_rviz" pkg="rviz" type="rviz"
    args="-d $(arg rviz_config)"/>
</launch>
