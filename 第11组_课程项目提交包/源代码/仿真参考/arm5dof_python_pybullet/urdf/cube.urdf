<?xml version="1.0" encoding="utf-8"?>
<!--木质物块 3cm-->
<robot
  name="cube">
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-4.7057E-19 -9.8036E-21 -9.8036E-19"
        rpy="0 0 0" />
      <mass
        value="0.00918" />
      <inertia
        ixx="1.377E-06"
        ixy="4.235E-41"
        ixz="4.235E-39"
        iyy="1.377E-06"
        iyz="8.823E-41"
        izz="1.377E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/cube.STL" />
      </geometry>
      <material
        name="wood">
        <color
          rgba="1 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/cube.STL" />
      </geometry>
    </collision>
    <contact>
      <lateral_friction value="2.0"/>
      <rolling_friction value="0.0001"/>
      <inertia_scaling value="3.0"/>
    </contact>
  </link>
</robot>